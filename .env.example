# ==============================================================================
# IHSG Terminal Pro — Unified Vercel Environment Configuration Template
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Frontend Configuration (Vite)
# ------------------------------------------------------------------------------
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# ------------------------------------------------------------------------------
# 2. Supabase Database & Auth (Backend Serverless)
# ------------------------------------------------------------------------------
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-service-role-or-anon-key
SUPABASE_DB_URL=postgresql://postgres.your-ref:your-password@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres

# ------------------------------------------------------------------------------
# 3. Security & JWT Settings
# ------------------------------------------------------------------------------
JWT_SECRET=your-secure-jwt-secret-string-at-least-32-characters
ALGORITHM=HS256

# ------------------------------------------------------------------------------
# 4. Serverless & Environment
# ------------------------------------------------------------------------------
ENVIRONMENT=production
ALLOWED_ORIGINS=http://localhost:5173,https://*.vercel.app

# ------------------------------------------------------------------------------
# 5. SMTP Email Settings (Reset Password & Verifikasi Email)
# ------------------------------------------------------------------------------
# Dapatkan App Password dari https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_EMAIL=your-email@gmail.com
SMTP_PASSWORD=your-gmail-app-password
