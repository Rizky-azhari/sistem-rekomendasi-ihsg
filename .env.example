# IHSG Terminal Environment Configuration Template
# Salin file ini menjadi .env dan sesuaikan nilainya.

# Supabase Settings
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-or-service-role-key
SUPABASE_DB_URL=postgresql://postgres.your-ref:your-password@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres

# Security & Token Secrets
JWT_SECRET=your-secure-jwt-secret-string-at-least-32-characters
ALGORITHM=HS256

# Server Settings
BACKEND_PORT=8000
ENVIRONMENT=development
ALLOWED_ORIGINS=http://localhost:5173,https://ihsg-terminal.vercel.app

# SMTP Email Settings (untuk pengiriman kode verifikasi reset password)
# Gunakan Gmail App Password: https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_EMAIL=your-email@gmail.com
SMTP_PASSWORD=your-gmail-app-password
